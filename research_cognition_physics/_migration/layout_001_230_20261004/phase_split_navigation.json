  "phases": [
    {
      "start": 1,
      "end": 20,
      "title": "预测状态、顺序读取与经典实现边界",
      "question": "认知闭环和有限读取能约束哪些预测状态与过程？",
      "results": [
        "建立预测摘要、准备—读取—更新模型及记录—状态连续极限。",
        "区分预测维数、隐藏标签数和有限协议近似；有限隐藏模型受限，但连续经典实现仍成立。"
      ],
      "limits": "这些认知条件尚未排除经典理论，也未给出物理时间或量子结构。",
      "keys": [
        1,
        4,
        15,
        18,
        19,
        20
      ],
      "transition": "21轮开始明确加入准备非情境性，并研究其可行阈值。",
      "directory": "archive_001_020"
    },
    {
      "start": 21,
      "end": 45,
      "title": "准备非情境性与精确强度阈值",
      "question": "完整顺序操作在准备非情境要求下能实现到什么强度？",
      "results": [
        "把完整更新核的存在性转化为凸序、耦合与可复算区间证书。",
        "45轮构造连续端点核，闭合指定模型的精确阈值；此前数值逼近和有限标签成本保留。"
      ],
      "limits": "阈值属于明确的准备、读取和旋转合同；准备非情境性本身不是此前认知闭环的已证推论。",
      "keys": [
        21,
        29,
        30,
        35,
        44,
        45
      ],
      "transition": "46轮转向量子表示、共同操作和联合态结构。",
      "directory": "archive_021_045"
    },
    {
      "start": 46,
      "end": 77,
      "title": "实复量子接口、共享参考与网络检验",
      "question": "实量子候选缺少哪些局部能力，新增方向或参考怎样改变组合与网络统计？",
      "results": [
        "刻画实联合态的隐藏坐标、操作扩展及新增Y读取后的条件性复闭包。",
        "推导声明的独立源无消息实网络上界，并给有限复资源越界与提前反馈恢复的构造。",
        "区分共同概率记录与通信因果结构，构造有限干预检验。"
      ],
      "limits": "共同门、辅助准备、Y能力和网络权限均按输入记账；十个态参数不是十维空间。",
      "keys": [
        46,
        52,
        57,
        60,
        68,
        69,
        73,
        77
      ],
      "transition": "78轮起从整体、分化和协作研究共同取向、分层与记忆。",
      "directory": "archive_046_077"
    },
    {
      "start": 78,
      "end": 99,
      "title": "共同取向、分层组合与关系记忆",
      "question": "整体保留而访问划分变化时，怎样维持旧能力并形成新的共同能力？",
      "results": [
        "审查组合相容、环路一致性与保留能力的扩容；85轮给共同J的复接口。",
        "建立复整体中的实接口和重新组合，并刻画关系写入、汇集及多查询权衡。"
      ],
      "limits": "J与允许操作仍依赖声明条件；关系记忆的改进不等同于复结构的认知必然性。",
      "keys": [
        80,
        82,
        85,
        87,
        93,
        94,
        99
      ],
      "transition": "100轮明确区分保存旧答案与保留未来查询，转向环境恢复和学习。",
      "directory": "archive_078_099"
    },
    {
      "start": 100,
      "end": 124,
      "title": "未来查询、环境恢复与自我审计",
      "question": "旧记录、环境关联、学习和自我预测能否维持未来可用的认知能力？",
      "results": [
        "给部分环境及隐藏关联下的恢复、有限成本和学习—查询闭环。",
        "建立自我审计的经典和实模型，区分校准、读取自身未知态与不可扰动要求。",
        "共享实参考可复用；维护代价需要声明存储噪声和任务条件。"
      ],
      "limits": "自我认知与参考维护尚不能独自选出复结构；记录、权限和未知来源条件不得省略。",
      "keys": [
        100,
        108,
        114,
        118,
        120,
        122,
        124
      ],
      "transition": "125轮开始研究全新独立主体保留未知状态地接入共同参考。",
      "directory": "archive_100_124"
    },
    {
      "start": 125,
      "end": 148,
      "title": "独立主体接入与相干历史",
      "question": "新主体怎样在保留旧状态、能力和外部关联的同时加入整体？",
      "results": [
        "求指定独立编码下的精确与近似接入边界、多主体扩展及原门电路。",
        "区分经典历史和相干历史恢复能力；给一相干位加经典标签的完整关联保护与编译。"
      ],
      "limits": "最优性针对固定任务、编码和访问合同；原始控制和指针准备成本明确，不是任意认知系统的普遍成本。",
      "keys": [
        125,
        126,
        128,
        135,
        141,
        144,
        145,
        148
      ],
      "transition": "149轮开始压缩历史标签并优化有限含噪恢复方案。",
      "directory": "archive_125_148"
    },
    {
      "start": 149,
      "end": 170,
      "title": "含噪恢复的全局证书与资源优化",
      "question": "在固定读取、消息和门预算中，如何认证完整恢复通道的最坏误差？",
      "results": [
        "将完整外部恢复误差化为低维Gram谱，区分局部代价之和与同一未知输入的真正损失。",
        "用解析导数和区间覆盖认证全局误差；确定四角度类别的界，并构造跨类别改善及门成本。"
      ],
      "limits": "最优性只在明示恢复器类别或固定策略中成立，不证明复数表示的必要性，也不覆盖一般CPTP恢复器。",
      "keys": [
        149,
        155,
        158,
        160,
        161,
        167,
        169,
        170
      ],
      "transition": "171轮明确结束把恢复器优化当结构必要性证明的路线，转向重建公理。",
      "directory": "archive_149_170"
    },
    {
      "start": 171,
      "end": 189,
      "title": "结构必要性、纯化与重建公理",
      "question": "真正要选择的是哪类操作结构，纯化、层析与组合分别增加什么？",
      "results": [
        "区分复数表示与实Kähler等价描述；历史保留、纯化、局部校准并不互相替代。",
        "在明确矩阵候选族中分析组合与纯化筛选；审查齐次性、自对偶和Jordan重建接口。",
        "记录共享参考校准的充要条件与未知参考歧义，统一登记量词和权限。"
      ],
      "limits": "条件性重建与认知动机的必要性分开；纯化单独不能排除通常实量子。",
      "keys": [
        171,
        173,
        178,
        180,
        183,
        187,
        189
      ],
      "transition": "190轮进入SoCA功能结构与几何描述、记忆及任务投影的对应检验。",
      "directory": "archive_171_189"
    },
    {
      "start": 190,
      "end": 204,
      "title": "SoCA、几何投影与任务充分性",
      "question": "功能闭环、记忆和预测怎样映射到几何状态描述，哪些信息不能在投影中丢失？",
      "results": [
        "把SoCA—Kähler关系分级为可检验的状态充分性、更新和准备混合要求。",
        "给主动任务的记忆反例、有限过程近似及延迟查询容量比较。",
        "203轮回顾旧研究；204轮区分候选竞争的Fisher—Kähler几何与完整量子操作结构。"
      ],
      "limits": "几何表示、经典闭环嵌入和任务优势均未证明完整SoCA或量子理论的认知唯一性。",
      "keys": [
        190,
        193,
        195,
        198,
        201,
        203,
        204
      ],
      "transition": "205轮把共享参考放回整体内部资源账，继续检验共同J和问题—动作结构。",
      "directory": "archive_190_204"
    },
    {
      "start": 205,
      "end": 216,
      "title": "内部资源、共同J与问题—动作相容",
      "question": "把参考与成本计入整体以后，哪些交互和可逆动作条件能支持共同复接口？",
      "results": [
        "核对参考维护和实际建树成本，区分声明成本模型与自发复结构。",
        "研究双实接口、三个锐问题生成J、协变问题—动作映射及其适用边界。",
        "刻画Jordan—Lie相容、完整实可观察量障碍和辅助归还条件。"
      ],
      "limits": "三方向结论不能提升为任意复整体的球对称；内部化参考也不自动等于参考独立，认知来源仍待明确。",
      "keys": [
        205,
